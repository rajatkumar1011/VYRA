# Required for live speech. Create a key at https://app.gnani.ai/voice/
GNANI_API_KEY=
# prisma-v2.5 is the challenge baseline. prisma-v3.0 is also supported.
GNANI_STT_MODEL=prisma-v2.5
# Required in production; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: OpenAI-compatible reasoning. Empty means deterministic local intent parser.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Optional Neon Postgres. Empty = temporary server memory; not reliable on serverless deployments.
DATABASE_URL=
